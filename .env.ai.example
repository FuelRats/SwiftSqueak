# AI assistant credentials for the live-test rig (docker-compose.dev.ai.override.yml).
# Copy to .env.ai (gitignored) and fill in the two tokens. The assistant is inert
# unless AI_ANTHROPIC_TOKEN, AI_OUTLINE_TOKEN, and AI_FRKB_COLLECTION_ID are all set.

AI_ANTHROPIC_TOKEN=
# Outline API token whose owner is a member of the private ED-Knowledge collection.
AI_OUTLINE_TOKEN=

# Public FRKB collection (SOP grounding).
AI_FRKB_COLLECTION_ID=9481d159-2515-4230-8c43-90944c94f87b
# Private ED-Knowledge collection (game-mechanics grounding).
AI_ED_KB_COLLECTION_ID=d2a320cb-2299-4f4e-93f9-36a701ba216e
AI_OUTLINE_BASE_URL=https://docs.fuelrats.com/api

# Optional: NickServ password if MechaAITest is a registered dev nick.
# IRC_AUTH_PASSWORD=
